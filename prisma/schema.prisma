generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  shortName String
  accent    String
  articles  Article[]
}

model Article {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  dek              String
  body             String
  image            String
  imageAlt         String
  coverImage       String?
  author           String
  source           String?
  tags             String        @default("")
  isBreaking       Boolean       @default(false)
  featured         Boolean       @default(false)
  featuredVideoUrl String?
  status           ArticleStatus @default(DRAFT)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// One page view on the public site, recorded by /api/track. No IP address or
/// cookie is stored: visitorHash is a one-way hash that changes every day, so it
/// can only count unique visitors per day.
model PageView {
  /// Generated in the browser so the end-of-visit beacon can add read time and scroll depth.
  id           String   @id
  createdAt    DateTime @default(now())
  path         String
  articleSlug  String?
  hub          String?
  visitorHash  String
  /// facebook | x | instagram | tiktok | whatsapp | threads | youtube | telegram | linkedin | google | bing | other-search | direct | other
  source       String
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  /// ISO 3166-1 alpha-2 country code, from Vercel's location headers.
  country      String?
  region       String?
  city         String?
  /// mobile | tablet | desktop
  device       String
  browser      String?
  os           String?
  /// Seconds the page was open (capped at 30 minutes), set when the reader leaves.
  durationSec  Int?
  /// Furthest the reader scrolled, 0-100.
  scrollPct    Int?

  @@index([createdAt])
  @@index([articleSlug, createdAt])
}

/// A video in the Watch section: a YouTube link or a file uploaded to Vercel Blob.
model Video {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  /// "youtube" or "upload"
  kind        String
  /// The 11-character YouTube id, for kind "youtube".
  youtubeId   String?
  /// The uploaded file's Blob URL, for kind "upload".
  videoUrl    String?
  thumbnail   String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

/// A banner in one or more of the site's ad spaces (see src/lib/ads.ts).
model Ad {
  id             String    @id @default(cuid())
  /// Advertiser or campaign name, shown only in the admin.
  name           String
  /// "leaderboard" (wide), "rectangle" (box) or "sidebar" (tall).
  size           String
  imageUrl       String
  /// Optional narrower banner for phones, for wide banners.
  mobileImageUrl String?
  linkUrl        String
  altText        String    @default("")
  /// Placement ids from src/lib/ads.ts.
  placements     String[]
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
}

/// A Google Alerts RSS feed added from the AI Desk (on top of any in NEWS_ALERTS_RSS_URL).
model AlertFeed {
  id        String   @id @default(cuid())
  url       String   @unique
  /// The alert's keyword, read from the feed title when it was added.
  keyword   String   @default("")
  createdAt DateTime @default(now())
}
