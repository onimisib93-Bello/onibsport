# Postgres connection string (from Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin login (used only by prisma/seed.ts to create the first admin user)
ADMIN_EMAIL="onibsport@gmail.com"
ADMIN_PASSWORD="change-this-password"

# Signs the admin session cookie — generate with: openssl rand -hex 32
AUTH_SECRET=""

# Used by the AI auto-drafting pipeline (src/lib/ai/draft.ts) — leave blank to keep the pipeline in stub mode
ANTHROPIC_API_KEY=""

# Free key from football-data.org/client/register — powers real live scores/tables
# for Premier League, La Liga, Serie A, Bundesliga, Champions League. Leave blank
# to keep using mock fixtures/standings. NPFL/Nigeria Football always use mock
# data (not covered by football-data.org's free tier).
FOOTBALL_DATA_API_KEY=""

# Optional: one or more Google Alerts RSS feed URLs, comma-separated (each
# alert must be individually switched to "RSS feed" delivery — Google gives
# each one its own separate feed link, there's no combined feed). Powers the
# AI Desk's incoming-story queue. Leave blank to keep using the sample queue.
# Example: NEWS_ALERTS_RSS_URL="https://google.com/alerts/feeds/.../1,https://google.com/alerts/feeds/.../2"
NEWS_ALERTS_RSS_URL=""

SITE_URL="http://localhost:3000"
